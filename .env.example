# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password_here
DB_PORT=3306
DB_NAME=chessusnode

# JWT Secrets (Optional - if not set, secrets will be auto-generated and saved to server/.jwt-secrets.json)
# For production, set these to stable random values (64+ chars recommended)
# Example: openssl rand -hex 64
ACCESS_TOKEN_SECRET=your_jwt_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here

# Server Port (optional, defaults to 3001)
PORT=3001

# Google OAuth
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id_here

# Twitch API (optional) — enables live status detection on the Streams page AND Twitch OAuth login.
# Create a CONFIDENTIAL app at https://dev.twitch.tv/console/apps to get these values.
# If not set, user streams appear offline and the Twitch login button is hidden.
# TWITCH_CLIENT_ID=your_twitch_client_id_here
# TWITCH_CLIENT_SECRET=your_twitch_client_secret_here

# CORS Configuration (optional, for additional custom origins)
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Remote AI trainer (optional). Set on the BACKEND server when the Rust trainer
# runs on a separate host. The backend will POST training jobs to this URL.
# Leave unset for local-only training (the backend will spawn the trainer itself).
# REMOTE_TRAINER_URL=https://your-trainer-host.example.com
# TRAINER_SHARED_SECRET=generate_a_long_random_string_and_use_the_same_value_on_both_hosts

# AI training data directory (optional, trainer/frontend EC2 only).
# Absolute path to the ai-training/ folder on this machine.
# Defaults to ai-training/ inside the repo root when unset.
# TRAINING_DATA_DIR=/data/ai-training

# Backup destination for training data (optional, trainer/frontend EC2 only).
# Used by the admin portal "Backup" button in the AI Training tab.
# If unset, backup requests will be skipped with a warning.
# TRAINING_BACKUP_DIR=/data/ai-training-backup
