# Backend Production Environment Variables
# Copy this to .env on your production server and fill in real values

ACCESS_TOKEN_SECRET=your_access_token_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here

# Stripe Payment Configuration (LIVE keys for production)
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_YOUR_STRIPE_SECRET_KEY_HERE

# Stripe webhook signing secret (reliable, server-side donation tracking)
# Create a webhook endpoint in the Stripe Dashboard pointing to:
#   https://gridgrove.gg/api/stripe-webhook
# subscribe to the "checkout.session.completed" event, then copy the signing secret here.
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_WEBHOOK_SIGNING_SECRET_HERE

# PayPal server-side credentials (enables verified PayPal donation tracking).
# Get from: https://developer.paypal.com/dashboard/applications
# PAYPAL_ENV: "live" for production, "sandbox" for testing.
PAYPAL_ENV=live
PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID_HERE
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_CLIENT_SECRET_HERE
# PayPal webhook id — create a webhook in the PayPal Dashboard pointing to:
#   https://gridgrove.gg/api/paypal-webhook
# subscribe to "PAYMENT.CAPTURE.COMPLETED", then copy the Webhook ID here.
PAYPAL_WEBHOOK_ID=YOUR_PAYPAL_WEBHOOK_ID_HERE

# Client URL for payment redirects (YOUR PRODUCTION DOMAIN)
CLIENT_URL=https://gridgrove.gg

# AWS SES Email Configuration
# Create IAM user with SES permissions: https://console.aws.amazon.com/iam/
# Verify sender email in SES: https://console.aws.amazon.com/ses/
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID_HERE
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY_HERE
AWS_SES_FROM_EMAIL=noreply@gridgrove.gg

# Google OAuth
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id_here

# Lichess OAuth
LICHESS_CLIENT_ID=gridgrove-app

# Twitch OAuth — BACKEND ONLY (never expose the secret to the frontend)
# Create a CONFIDENTIAL app at https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here
