# Trainer service environment variables
# Copy this file to server/ai/.env and fill in your values.
# server/ai/.env is git-ignored and should never be committed.

# -------------------------------------------------------------------------
# REQUIRED
# -------------------------------------------------------------------------

# Secret token shared between the backend (trainer-client.js) and this
# service. Generate a strong random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TRAINER_SHARED_SECRET=changeme

# -------------------------------------------------------------------------
# DATABASE  (same credentials used by the main backend)
# -------------------------------------------------------------------------

DB_HOST=localhost
DB_USER=chessus
DB_PASSWORD=your_db_password
DB_NAME=chessus

# -------------------------------------------------------------------------
# OPTIONAL
# -------------------------------------------------------------------------

# Port the trainer service listens on (default: 4101)
# TRAINER_PORT=4101

# Host to bind to (default: 127.0.0.1 — local VPC traffic only)
# TRAINER_BIND_HOST=127.0.0.1

# Directory where ai-training data lives on this machine.
# Defaults to the ai-training/ folder inside the repo root.
# TRAINING_DATA_DIR=/data/ai-training

# Absolute path for training job backups created by POST /trainer/backup.
# If unset, backup is skipped with a warning.
TRAINING_BACKUP_DIR=/data/ai-training-backup
