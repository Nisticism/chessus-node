# Git push configuration (template)
#
# Why this exists: VS Code signs in to GitHub through its own GitHub
# Authentication extension and hands git an in-memory askpass helper. Nothing is
# written to git's config or to a credential store on disk, so a plain terminal
# (or an agent shell) has no credentials at all and `git push` fails with
#   fatal: could not read Username for 'https://github.com'
#
# SSH is the durable fix: unlike a Personal Access Token, an SSH key does not
# expire, so this only has to be set up once.
#
# ── Setup ────────────────────────────────────────────────────────────────
# 1. Create a key (no passphrase, so scripts can use it non-interactively):
#      ssh-keygen -t ed25519 -C "gridgrove" -f ~/.ssh/id_ed25519_gridgrove -N ""
#
# 2. Add the PUBLIC half at https://github.com/settings/keys
#    (paste the contents of ~/.ssh/id_ed25519_gridgrove.pub)
#
# 3. Copy this file to `.git-credentials.env` (already gitignored) and set
#    SSH_KEY_PATH below to the PRIVATE key. Never put the key itself in here —
#    only the path to it.
#
# 4. Point the remote at SSH (once):
#      git remote set-url origin git@github.com:Nisticism/chessus-node.git
#
# Then push with:  ./scripts/git-push.sh [branch]
#
# ── Settings ─────────────────────────────────────────────────────────────

# Path to the PRIVATE SSH key. ~ is expanded.
SSH_KEY_PATH=~/.ssh/id_ed25519_gridgrove

# SSH URL for the repository. Used to switch the remote automatically if it is
# still on https, so step 4 above is optional.
GIT_REMOTE_SSH_URL=git@github.com:Nisticism/chessus-node.git

# ── Legacy token fallback (optional) ─────────────────────────────────────
# Only needed if you'd rather keep using a Personal Access Token than SSH. A
# fine-grained token needs "Contents: Read and write" on this repository, and
# expires on the date you chose when creating it. Leave these blank to use SSH.
GITHUB_USERNAME=
GITHUB_TOKEN=
